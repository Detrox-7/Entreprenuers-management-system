<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="title" value="Entrepreneurs"/><%@ include file="_header.jspf" %>
<c:set var="editing" value="${record.entrepreneurId gt 0}"/><div class="page-title-row"><div><h1><c:choose><c:when test="${editing}">Edit entrepreneur</c:when><c:otherwise>Add entrepreneur</c:otherwise></c:choose></h1><p class="page-subtitle">Enter the registered entrepreneur's details.</p></div><a class="button secondary" href="${ctx}/entrepreneurs">Back to list</a></div>
<section class="section-card"><form method="post" action="${ctx}/entrepreneurs/save"><c:if test="${editing}"><input type="hidden" name="id" value="<c:out value='${record.entrepreneurId}'/>"></c:if><div class="form-grid">
<div class="field"><label for="fullName">Full name *</label><input id="fullName" name="fullName" maxlength="120" required value="<c:out value='${record.fullName}'/>"></div>
<div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" maxlength="150" required value="<c:out value='${record.email}'/>"></div>
<div class="field"><label for="phone">Phone</label><input id="phone" name="phone" maxlength="30" value="<c:out value='${record.phone}'/>"></div><div class="field"><label for="gender">Gender</label><select id="gender" name="gender"><option value="">Select</option><option>Female</option><option>Male</option><option>Non-binary</option><option>Prefer not to say</option></select></div>
<div class="field"><label for="dateOfBirth">Date of birth</label><input id="dateOfBirth" name="dateOfBirth" type="date" value="<c:out value='${record.dateOfBirth}'/>"></div><div class="field"><label for="registrationDate">Registration date *</label><input id="registrationDate" name="registrationDate" type="date" required value="<c:out value='${record.registrationDate}'/>"></div>
<div class="field"><label for="address">Address</label><input id="address" name="address" maxlength="255" value="<c:out value='${record.address}'/>"></div><div class="field"><label for="city">City</label><input id="city" name="city" maxlength="80" value="<c:out value='${record.city}'/>"></div>
<div class="field"><label for="state">State</label><input id="state" name="state" maxlength="80" value="<c:out value='${record.state}'/>"></div><div class="field"><label for="status">Status</label><select id="status" name="status"><option ${record.status eq 'Active'?'selected':''}>Active</option><option ${record.status eq 'Pending'?'selected':''}>Pending</option><option ${record.status eq 'Inactive'?'selected':''}>Inactive</option></select></div></div>
<div class="modal-actions"><a class="button secondary" href="${ctx}/entrepreneurs">Cancel</a><button class="button primary" type="submit">Save entrepreneur</button></div></form></section><%@ include file="_footer.jspf" %>
