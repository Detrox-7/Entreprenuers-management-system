<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${title}"/> · Entrepreneurs Management System</title><link rel="stylesheet" href="${ctx}/assets/styles.css"></head><body>
<div class="app"><aside class="sidebar"><div class="side-brand"><span class="brand-mark small">E</span><span><b>Entrepreneur</b><small>Management System</small></span></div><div class="nav-label">WORKSPACE</div><nav aria-label="Main navigation">
<a class="nav-item ${title eq 'Dashboard'?'active':''}" href="${ctx}/dashboard"><span>▦</span>Dashboard</a><a class="nav-item ${title eq 'Entrepreneurs'?'active':''}" href="${ctx}/entrepreneurs"><span>♙</span>Entrepreneurs</a><a class="nav-item ${title eq 'Businesses'?'active':''}" href="${ctx}/businesses"><span>▤</span>Businesses</a><a class="nav-item ${title eq 'Employees'?'active':''}" href="${ctx}/employees"><span>♧</span>Employees</a><a class="nav-item ${title eq 'Investments'?'active':''}" href="${ctx}/investments"><span>◈</span>Investments</a><a class="nav-item ${title eq 'Reports'?'active':''}" href="${ctx}/reports"><span>▥</span>Reports</a><a class="nav-item ${title eq 'Settings'?'active':''}" href="${ctx}/settings"><span>⚙</span>Settings</a></nav>
<div class="sidebar-bottom"><span class="avatar">AD</span><span class="user-info"><b><c:out value="${sessionScope.username}"/></b><small><c:out value="${sessionScope.role}"/></small></span><form method="post" action="${ctx}/logout"><button class="icon-button" title="Log out" aria-label="Log out">↪</button></form></div></aside>
<section class="main-area"><header class="topbar"><div><span class="crumb">Workspace</span><span class="crumb-sep">/</span><b><c:out value="${title}"/></b></div><div class="top-right"><span class="avatar">AD</span></div></header><main class="content">
<c:if test="${not empty sessionScope.notice}"><div class="section-card" role="status"><c:out value="${sessionScope.notice}"/><c:remove var="notice" scope="session"/></div></c:if><c:if test="${not empty error}"><div class="section-card error" role="alert"><c:out value="${error}"/></div></c:if>
