<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="title" value="${title}"/><%@ include file="_header.jspf" %>
<div class="page-title-row"><div><h1><c:out value="${title}"/></h1><p class="page-subtitle">Manage registered <c:out value="${kind}"/> records.</p></div><a class="button primary" href="${ctx}/${kind}/new">＋ Add <c:out value="${kind}"/></a></div>
<section class="table-panel"><div class="table-scroll"><table><thead><tr><th>ID</th><th>NAME</th><th>RELATED TO</th><th>DETAIL</th><th>TYPE</th><th>ACTIONS</th></tr></thead><tbody><c:forEach var="r" items="${records}"><tr><td><c:out value="${r.id}"/></td><td><span class="person-name"><c:out value="${r.name}"/></span></td><td><c:out value="${r.parent}"/></td><td><c:choose><c:when test="${kind eq 'businesses'}"><c:out value="${r.industry}"/> · <c:out value="${r.location}"/></c:when><c:when test="${kind eq 'employees'}"><c:out value="${r.email}"/> · <c:out value="${r.phone}"/></c:when><c:otherwise>₹ <c:out value="${r.amount}"/></c:otherwise></c:choose></td><td><c:out value="${r.type}"/></td><td><div class="actions"><a class="action-btn" href="${ctx}/${kind}/edit?id=${r.id}">Edit</a><form method="post" action="${ctx}/${kind}/delete" onsubmit="return confirm('Delete this record?')"><input type="hidden" name="id" value="${r.id}"><button class="action-btn delete">Delete</button></form></div></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="6"><div class="empty-state"><strong>No records yet</strong>Add a record to get started.</div></td></tr></c:if></tbody></table></div></section><%@ include file="_footer.jspf" %>
