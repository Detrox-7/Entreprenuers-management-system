<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="title" value="Entrepreneurs"/><%@ include file="_header.jspf" %>
<div class="page-title-row"><div><h1>Entrepreneurs</h1><p class="page-subtitle">Manage profile details and registration status.</p></div><a class="button primary" href="${ctx}/entrepreneurs/new">＋ Add entrepreneur</a></div>
<section class="table-panel"><form class="toolbar" method="get" action="${ctx}/entrepreneurs"><div class="search-wrap"><span class="search-glyph">⌕</span><input name="q" type="search" value="<c:out value='${param.q}'/>" placeholder="Search name, email, city" aria-label="Search entrepreneurs"></div><select name="status" aria-label="Filter status"><option value="">All statuses</option><option value="Active" ${param.status eq 'Active'?'selected':''}>Active</option><option value="Pending" ${param.status eq 'Pending'?'selected':''}>Pending</option><option value="Inactive" ${param.status eq 'Inactive'?'selected':''}>Inactive</option></select><button class="button secondary">Apply filters</button></form><div class="table-scroll"><table><thead><tr><th>ID</th><th>ENTREPRENEUR</th><th>PHONE</th><th>LOCATION</th><th>REGISTERED</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody><c:forEach var="r" items="${records}"><tr><td><c:out value="${r.entrepreneurId}"/></td><td><div class="person-cell"><span class="person-initial">EMS</span><div><div class="person-name"><c:out value="${r.fullName}"/></div><div class="person-email"><c:out value="${r.email}"/></div></div></div></td><td><c:out value="${r.phone}"/></td><td><c:out value="${r.city}"/>, <c:out value="${r.state}"/></td><td><c:out value="${r.registrationDate}"/></td><td><span class="status status-${r.status.toLowerCase()}"><c:out value="${r.status}"/></span></td><td><div class="actions"><a class="action-btn" href="${ctx}/entrepreneurs/edit?id=${r.entrepreneurId}">Edit</a><form method="post" action="${ctx}/entrepreneurs/delete" onsubmit="return confirm('Delete this entrepreneur and their linked businesses?')"><input type="hidden" name="id" value="${r.entrepreneurId}"><button class="action-btn delete">Delete</button></form></div></td></tr></c:forEach><c:if test="${empty records}"><tr><td colspan="7"><div class="empty-state"><strong>No entrepreneur records</strong>Add an entrepreneur to begin.</div></td></tr></c:if></tbody></table></div></section>
<%@ include file="_footer.jspf" %>
