<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="title" value="Dashboard"/><%@ include file="_header.jspf" %>
<div class="page-title-row"><div><h1>Dashboard</h1><p class="page-subtitle">A quick overview of your entrepreneur community.</p></div><a class="button primary" href="${ctx}/entrepreneurs/new">＋ Add entrepreneur</a></div>
<section class="stats"><article class="stat-card"><span class="stat-label">Total Entrepreneurs</span><div class="stat-value"><c:out value="${summary.entrepreneurs}"/></div><div class="stat-note">Registered profiles</div></article><article class="stat-card"><span class="stat-label">Active Businesses</span><div class="stat-value"><c:out value="${summary.businesses}"/></div><div class="stat-note">Currently active</div></article><article class="stat-card"><span class="stat-label">Startups</span><div class="stat-value"><c:out value="${summary.startups}"/></div><div class="stat-note">Startup ventures</div></article><article class="stat-card"><span class="stat-label">Pending Entries</span><div class="stat-value"><c:out value="${summary.pending}"/></div><div class="stat-note">Awaiting review</div></article></section>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><h2>Quick links</h2></div><p class="muted">Choose a section from the navigation to manage your records.</p><div class="actions"><a class="button secondary" href="${ctx}/entrepreneurs">Entrepreneurs</a><a class="button secondary" href="${ctx}/businesses">Businesses</a></div></section><section class="panel"><div class="panel-heading"><h2>System summary</h2></div><p>Employees: <b><c:out value="${summary.employees}"/></b></p><p>Investment records: <b><c:out value="${summary.investments}"/></b></p><p class="muted">Counts are read directly from the connected MySQL database.</p></section></div>
