<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="title" value="${title}"/><%@ include file="_header.jspf" %><c:set var="editing" value="${not empty record.id}"/>
<div class="page-title-row"><div><h1><c:choose><c:when test="${editing}">Edit</c:when><c:otherwise>Add</c:otherwise></c:choose> <c:out value="${kind}"/></h1><p class="page-subtitle">Complete the details below.</p></div><a class="button secondary" href="${ctx}/${kind}">Back to list</a></div>
<section class="section-card"><form method="post" action="${ctx}/${kind}/save"><c:if test="${editing}"><input type="hidden" name="id" value="${record.id}"></c:if><div class="form-grid">
<div class="field"><label for="parentId"><c:out value="${kind eq 'businesses'?'Entrepreneur':'Business'}"/> *</label><select name="parentId" id="parentId" required><option value="">Select related record</option><c:forEach var="p" items="${parents}"><option value="${p.id}" ${record.parentId eq p.id?'selected':''}><c:out value="${p.name}"/></option></c:forEach></select></div>
<div class="field"><label for="name">Name *</label><input id="name" name="name" required value="<c:out value='${record.name}'/>"></div>
<c:if test="${kind eq 'businesses'}"><div class="field"><label>Business type</label><select name="type"><option>Startup</option><option>Small Business</option><option>Enterprise</option></select></div><div class="field"><label>Industry</label><input name="industry" value="<c:out value='${record.industry}'/>"></div><div class="field"><label>Founded date</label><input name="date" type="date" value="<c:out value='${record.date}'/>"></div><div class="field"><label>Location</label><input name="location" value="<c:out value='${record.location}'/>"></div><div class="field"><label>Status</label><select name="status"><option>Active</option><option>Pending</option><option>Inactive</option></select></div><div class="field full-field"><label>Description</label><textarea name="description" rows="3"><c:out value="${record.description}"/></textarea></div></c:if>
<c:if test="${kind eq 'employees'}"><div class="field"><label>Email</label><input name="email" type="email" value="<c:out value='${record.email}'/>"></div><div class="field"><label>Phone</label><input name="phone" value="<c:out value='${record.phone}'/>"></div><div class="field"><label>Designation</label><input name="type" value="<c:out value='${record.type}'/>"></div><div class="field"><label>Joining date</label><input name="date" type="date" value="<c:out value='${record.date}'/>"></div></c:if>
<c:if test="${kind eq 'investments'}"><div class="field"><label>Amount (INR) *</label><input name="amount" type="number" min="0.01" step="0.01" required value="<c:out value='${record.amount}'/>"></div><div class="field"><label>Investment date</label><input name="date" type="date" value="<c:out value='${record.date}'/>"></div><div class="field"><label>Investment type</label><input name="type" placeholder="Equity, loan, grant" value="<c:out value='${record.type}'/>"></div></c:if>
</div><div class="modal-actions"><a class="button secondary" href="${ctx}/${kind}">Cancel</a><button class="button primary">Save record</button></div></form></section><%@ include file="_footer.jspf" %>
